# UtsavFlow AI — Environment Variables
# Copy this file to .env in the backend/ directory and fill in values.
# NEVER commit .env to git.

# ──────────────────────────────────────────────
# Google Gemini (optional — app works in demo mode without it)
# ──────────────────────────────────────────────

# Your Google Gemini API key. If absent or empty, demo mode is used automatically.
GEMINI_API_KEY=

# The Gemini model to use.
GEMINI_MODEL=gemini-3.8-flash

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────

# Backend server port
PORT=3001

# Frontend origin for CORS (no trailing slash)
# In production, set this to your actual frontend URL
CORS_ORIGIN=http://localhost:5173

# Node environment: development | production | test
NODE_ENV=development

# Reverse proxy trust setting: 'loopback' (safe default for local reverse proxies), 'false' (standalone direct internet), or '1' (first hop)
TRUST_PROXY=loopback

